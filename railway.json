{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -o valenced ./cmd/valenced"
  },
  "deploy": {
    "startCommand": "./valenced -port $PORT -data-dir /app/data -peers \"\" -faucet-key $FAUCET_KEY",
    "restartPolicyType": "ON_FAILURE"
  }
}
